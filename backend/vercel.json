{
  "version": 2,
  "buildCommand": "npm ci --omit=dev",
  "env": {
    "NODE_ENV": "production"
  },
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "functions": {
    "index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}